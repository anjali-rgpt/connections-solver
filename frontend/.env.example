# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# API Base URL
# In development: Backend runs at http://localhost:8000
# In production: Use your deployed backend URL or proxy through nginx
# Note: Frontend is client-side code; it cannot use Docker internal network names
VITE_API_URL=http://localhost:8000

# Node Environment
# Options: development, production, test
NODE_ENV=development
