# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Storage Configuration
# STORAGE_TYPE: "memory" (in-memory, data lost on restart) or "sqlite" (persistent)
STORAGE_TYPE=memory
# DATABASE_PATH: Path to SQLite database file (only used if STORAGE_TYPE=sqlite)
DATABASE_PATH=data/connections.db
